---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---

<Base title="Equipe e autores" description={`Conheça as pessoas que escrevem no ${site.name}.`}>
  <div class="container page">
    <header class="page-head">
      <h1>Equipe e autores</h1>
      <p>Quem escreve e revisa as matérias do {site.name}.</p>
    </header>
    <div class="prose plain" style="max-width:760px">
      <h2>[Nome do autor ou da autora]</h2>
      <p>
        [Mini biografia: formação, experiência na área e as editorias em que escreve. Inclua uma foto e links
        para redes sociais profissionais, se quiser.]
      </p>
      <h2>[Nome do segundo integrante]</h2>
      <p>[Repita o modelo para cada pessoa que assina matérias. Autores reais e identificáveis fortalecem a credibilidade do site.]</p>
    </div>
  </div>
</Base>
