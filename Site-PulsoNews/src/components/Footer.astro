---
import { site } from '../config';
import { categoryList } from '../lib/categories';

const year = new Date().getFullYear();
const social = [
  { label: 'Instagram', url: site.social.instagram },
  { label: 'YouTube', url: site.social.youtube },
  { label: 'X', url: site.social.x },
].filter((s) => s.url);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo" aria-label={`${site.name}, página inicial`}>
        <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
          <rect width="36" height="36" rx="9" fill="#FFD60A"></rect>
          <path d="M5 19h7l3-9 5 16 3-10 2 3h6" fill="none" stroke="#0E1116" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="logo-word">pulso</span>
      </a>
      <p>Portal independente de notícias sobre tecnologia, política e entretenimento, com clareza, contexto e checagem.</p>
      {
        social.length > 0 && (
          <div class="footer-social">
            {social.map((s) => (
              <a href={s.url} rel="noopener" target="_blank">{s.label}</a>
            ))}
          </div>
        )
      }
    </div>

    <nav class="footer-col" aria-label="Editorias">
      <h2>EDITORIAS</h2>
      {categoryList.map((c) => <a href={`/${c.slug}/`}>{c.label}</a>)}
    </nav>

    <nav class="footer-col" aria-label="Institucional">
      <h2>INSTITUCIONAL</h2>
      <a href="/sobre/">Quem somos</a>
      <a href="/equipe/">Equipe e autores</a>
      <a href="/privacidade/">Política de privacidade</a>
      <a href="/contato/">Contato e anúncios</a>
      <a href="/rss.xml">RSS</a>
    </nav>

    <div class="footer-col">
      <h2>ATENDIMENTO</h2>
      <p style="font-size:14px">Envie pautas, denúncias ou correções:</p>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      <div class="truth">
        <strong>COMPROMISSO COM A VERDADE</strong>
        <p>Todo conteúdo é revisado pela equipe editorial antes de ser publicado.</p>
      </div>
    </div>
  </div>
  <div class="footer-bottom container">© {year} {site.name}. Todos os direitos reservados.</div>
</footer>
