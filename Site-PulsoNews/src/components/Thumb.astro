---
// Foto da matéria. Se não houver foto, mostra um bloco colorido da editoria.
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { image, imageAlt } = post.data;
---

{
  image ? (
    <img src={image} alt={imageAlt ?? ''} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="thumb-ph" aria-hidden="true">
      <svg
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="1.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="9" cy="10" r="1.6" />
        <path d="M21 16l-5-5-9 9" />
      </svg>
    </div>
  )
}
