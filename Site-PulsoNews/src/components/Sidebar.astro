---
import AdSlot from './AdSlot.astro';
import Newsletter from './Newsletter.astro';
import { categories } from '../lib/categories';
import { postUrl } from '../lib/posts';
import type { Post } from '../lib/posts';

interface Props {
  posts?: Post[];
}

const { posts = [] } = Astro.props;
const list = posts.slice(0, 5);
---

<aside class="sidebar" aria-label="Barra lateral">
  <AdSlot id="A4" />

  {
    list.length > 0 && (
      <section class="box" aria-labelledby="destaques-t">
        <div class="box-head">
          <h2 id="destaques-t">Em destaque</h2>
        </div>
        <ol class="ranked">
          {list.map((p, i) => (
            <li style={`--accent:var(${categories[p.data.category].accentVar})`}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <div class="txt">
                <span class="kicker">{categories[p.data.category].label}</span>
                <a href={postUrl(p)}>{p.data.title}</a>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <Newsletter id="nl-side" />
  <AdSlot id="A5" />
</aside>
