---
import { site } from '../config';

interface Props {
  id?: string;
}

const { id = 'nl' } = Astro.props;
const action = site.newsletterAction;
---

<section class="nl" id={id} aria-labelledby={`${id}-t`}>
  <h2 id={`${id}-t`}>O dia em 5 minutos, direto no seu e-mail.</h2>
  <p>As notícias essenciais do dia, selecionadas pela redação. Sem spam.</p>
  <form action={action || undefined} method="post" target={action ? '_blank' : undefined} data-demo={action ? undefined : 'true'}>
    <label for={`${id}-email`}>Seu melhor e-mail</label>
    <input id={`${id}-email`} name="email" type="email" placeholder="nome@exemplo.com" required />
    <button type="submit">Inscrever-se grátis</button>
    <p class="msg" role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  // Enquanto a newsletter não estiver ligada (src/config.ts), mostra um aviso em vez de enviar.
  document.querySelectorAll('form[data-demo="true"]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = form.querySelector('.msg');
      if (msg) msg.textContent = 'A newsletter ainda não está ativa. Volte em breve!';
    });
  });
</script>
