---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---

<Base title="Equipe e autores" description={`Conheça quem escreve e revisa as matérias do ${site.name} e como funciona a redação.`}>
  <div class="container page">
    <header class="page-head">
      <h1>Equipe e autores</h1>
      <p>Quem escreve e revisa as matérias do {site.name}.</p>
    </header>
    <div class="prose plain" style="max-width:760px">
      <h2>Redação Pulso</h2>
      <p>
        As matérias assinadas como "Redação Pulso" são produzidas pela equipe do {site.name} a partir de fontes
        públicas e oficiais, e passam por revisão editorial antes de ir ao ar. Pedidos de correção podem ser
        enviados pela <a href="/contato/">página de contato</a>.
      </p>
    </div>
  </div>
</Base>
